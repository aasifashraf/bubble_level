<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: nothing goes to cloud backup or to a new phone.
     The Level's and Ruler's calibration belong to this phone's sensors and
     screen; restored onto another phone they would be wrong. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
